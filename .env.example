# ============================================================
# MoodLens - Environment Variables Example
# Copy this file to .env and fill in values
# NEVER commit .env to version control
# ============================================================

# Application
APP_NAME=MoodLens
APP_ENV=development
DEBUG=true
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret-key-minimum-32-chars

# Database
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://moodlens:moodlens_dev_password@localhost:5432/moodlens
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-jwt-secret-key-must-be-different-from-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS - comma-separated allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=5

# Spotify OAuth (optional - leave blank to disable Spotify integration)
# Register your app at: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:5173/settings/integrations/spotify/callback

# Email / SMTP (optional - for email verification and password reset)
# Free tier available at: https://resend.com or https://sendgrid.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@moodlens.app
EMAIL_VERIFICATION_ENABLED=false

# Model Configuration
MODEL_VERSION=1.0.0

# Frontend (Vite) - prefix with VITE_ for browser access
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
VITE_APP_ENV=development
VITE_SPOTIFY_CLIENT_ID=
